---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="二十周年档" description="永吧二十周年特别作品展示">
  <div class="min-h-screen pt-16">
    <section class="px-4 py-12">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="mb-4 text-3xl font-bold text-[var(--color-text-primary)] md:text-4xl">二十周年档</h1>
        <p class="text-lg text-[var(--color-text-secondary)]">周年庆特别作品展示</p>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 pb-16">
      <div class="card flex min-h-[400px] flex-col items-center justify-center p-8 text-center">
        <div class="mb-6 text-6xl">🎬</div>
        <h2 class="mb-3 text-xl font-semibold text-[var(--color-text-primary)]">内容即将上线</h2>
        <p class="mb-6 max-w-md text-[var(--color-text-secondary)]">
          二十周年档特别作品正在筹备中，敬请期待！
        </p>
        <div class="flex gap-4">
          <a href="/" class="btn-primary">返回首页</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
