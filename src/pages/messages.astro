---
import BaseLayout from '../layouts/BaseLayout.astro';
import MessageCard from '../components/MessageCard.astro';
import { loadYaml } from '../utils/loadYaml';
import type { MessageItem } from '../types/message';

const messages = await loadYaml<MessageItem[]>('messages.yaml');
---

<BaseLayout title="成员寄语" description="永吧吧友们的祝福与心声">
  <div class="min-h-screen pt-20">
    <section class="px-4 py-12">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="mb-4 text-3xl font-bold text-[var(--color-text-primary)] md:text-4xl">成员寄语</h1>
        <p class="text-lg leading-relaxed text-[var(--color-text-secondary)]">吧友们的心声与祝福，共同庆祝永吧二十周年</p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 pb-16">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {messages.map((message, index) => <MessageCard message={message} index={index} />)}
      </div>

      <div class="mt-12 text-center">
        <p class="text-sm text-[var(--color-text-muted)]">
          想要留下你的祝福？请联系吧务团队添加你的寄语。
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
