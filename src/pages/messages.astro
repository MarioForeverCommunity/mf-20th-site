---
import BaseLayout from '../layouts/BaseLayout.astro';
import MessageCard from '../components/MessageCard.astro';
import { loadYaml } from '../utils/loadYaml';
import type { MessageItem } from '../types/message';

const messages = await loadYaml<MessageItem[]>('messages.yaml');
---

<BaseLayout title="贺图寄语" description="永吧吧友们的祝福与心声">
  <div class="page-content">
    <section class="page-header">
      <div class="section-inner">
        <h1 class="page-title">贺图寄语</h1>
        <p class="page-desc">永吧二十周年贺图和寄语征稿活动火热进行中~</p>
      </div>
    </section>

    <section class="messages-section">
      <div class="section-inner">
        <div class="messages-grid">
          {messages.map((message, index) => <MessageCard message={message} index={index} />)}
        </div>

        <div class="messages-footer">
          <p class="footer-note">
            <a href="https://www.marioforever.net/thread-3916-1-1.html" target="_blank" rel="noopener noreferrer">想要留下你的祝福？请点击这里前往社区征集渠道投稿</a>。
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-content {
    min-height: 100%;
    padding-top: var(--layout-navbar-height);
  }

  .section-inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: 0 var(--layout-content-padding);
  }

  .page-header {
    padding: 36px 0;
    text-align: center;
  }

  .page-title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 8px;
  }

  .page-desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .messages-section {
    padding-bottom: 48px;
  }

  .messages-grid {
    display: grid;
    gap: var(--spacing-md);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .messages-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .messages-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .messages-footer {
    margin-top: 36px;
    text-align: center;
  }

  .footer-note {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  /* === 风格覆盖 === */

  /* 复古2006: 双列但紧凑 */
  :global([data-theme="retro"]) .messages-grid {
    gap: 2px;
  }
</style>
