---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="MF Direct" description="永吧二十周年作品直面会">
  <div class="min-h-screen pt-20">
    <section class="px-4 py-12">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="mb-4 text-3xl font-bold text-[var(--color-text-primary)] md:text-4xl">Mario Forever Direct</h1>
        <p class="text-lg leading-relaxed text-[var(--color-text-secondary)]">永吧二十周年作品直面会</p>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 pb-16">
      <div class="card flex min-h-[400px] flex-col items-center justify-center p-8 text-center">
        <div class="mb-6 text-6xl drop-shadow-sm">🎬</div>
        <h2 class="mb-3 text-xl font-semibold text-[var(--color-text-primary)]">敬请期待</h2>
        <p class="mb-6 max-w-md leading-relaxed text-[var(--color-text-secondary)]">
          Mario Forever Direct 正在筹备中，预计将于 8 月 19 日直播放映，敬请期待！
        </p>
        <div class="flex gap-4">
          <a href="/" class="btn-primary">返回首页</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
