---
import BaseLayout from '../layouts/BaseLayout.astro';
import SplashScreen from '../components/SplashScreen.astro';
import AvatarCluster from '../components/AvatarCluster.astro';
import Logo from '../components/Logo.astro';
import { readdirSync, existsSync } from 'fs';
import { join } from 'path';

const MAX_AVATARS = 80;

function getAvatarUsernames(): string[] {
  const avatarsDir = join(process.cwd(), 'public', 'images', 'avatars');

  if (!existsSync(avatarsDir)) {
    return [];
  }

  const files = readdirSync(avatarsDir);
  const imageExtensions = ['.jpg', '.jpeg', '.png', '.webp', '.svg'];

  const usernames = files
    .filter((file) => {
      const ext = file.toLowerCase().slice(file.lastIndexOf('.'));
      return imageExtensions.includes(ext);
    })
    .map((file) => file.replace(/\.[^.]+$/, ''))
    .filter((name) => name !== 'default');

  return usernames;
}

let usernames = getAvatarUsernames();

if (usernames.length > MAX_AVATARS) {
  usernames = usernames.sort(() => Math.random() - 0.5).slice(0, MAX_AVATARS);
}
---

<BaseLayout title="首页">
  <SplashScreen />

  <div class="min-h-screen pt-16">
    <section class="flex flex-col items-center justify-center px-4 py-16">
      <div class="mb-8">
        <Logo width={280} height={280} />
      </div>
      <p class="mb-8 max-w-2xl text-center text-lg text-[var(--color-text-secondary)]">
        2006 - 2026，二十年风雨同舟，感谢每一位吧友的陪伴与支持。
      </p>
    </section>

    <section class="relative overflow-hidden px-4 py-8">
      <div class="mx-auto max-w-6xl">
        <h2 class="mb-2 text-center text-2xl font-semibold text-[var(--color-text-primary)]">吧友头像墙</h2>
        <p class="mb-8 text-center text-sm text-[var(--color-text-muted)]">
          头像为随机选取，大小完全随机，无任何特定暗示或含义；吧友众多，难免存在遗漏，敬请见谅！
        </p>
        {
          usernames.length > 0 ? (
            <div class="flex justify-center">
              <AvatarCluster 
                usernames={usernames} 
                width={1000} 
                height={600}
                mobileWidth={360}
                mobileHeight={400}
                mobileMaxAvatars={35}
              />
            </div>
          ) : (
            <div class="rounded-lg bg-[var(--color-bg-secondary)] p-8 text-center">
              <p class="text-[var(--color-text-muted)]">暂无头像数据，请将头像文件放入 public/images/avatars/ 目录</p>
            </div>
          )
        }
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-16">
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/history" class="card group p-6 text-center">
          <div class="mb-4 text-4xl">📜</div>
          <h3 class="mb-2 text-lg font-semibold text-[var(--color-text-primary)]">历史沿革</h3>
          <p class="text-sm text-[var(--color-text-secondary)]">回顾永吧二十年的发展历程</p>
        </a>

        <a href="/messages" class="card group p-6 text-center">
          <div class="mb-4 text-4xl">💬</div>
          <h3 class="mb-2 text-lg font-semibold text-[var(--color-text-primary)]">成员寄语</h3>
          <p class="text-sm text-[var(--color-text-secondary)]">吧友们的心声与祝福</p>
        </a>

        <a href="/works" class="card group p-6 text-center">
          <div class="mb-4 text-4xl">🎬</div>
          <h3 class="mb-2 text-lg font-semibold text-[var(--color-text-primary)]">二十周年档</h3>
          <p class="text-sm text-[var(--color-text-secondary)]">周年庆特别作品展示</p>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
