---
import BaseLayout from '../layouts/BaseLayout.astro';
import SplashScreen from '../components/SplashScreen.astro';
import AvatarCluster from '../components/AvatarCluster.astro';
import Logo from '../components/Logo.astro';
import { readdirSync, existsSync } from 'fs';
import { join } from 'path';

function getAvatarUsernames(): string[] {
  const avatarsDir = join(process.cwd(), 'public', 'images', 'avatars');

  if (!existsSync(avatarsDir)) {
    return [];
  }

  const files = readdirSync(avatarsDir);
  const imageExtensions = ['.jpg', '.jpeg', '.png', '.webp', '.svg'];

  const usernames = files
    .filter((file) => {
      const ext = file.toLowerCase().slice(file.lastIndexOf('.'));
      return imageExtensions.includes(ext);
    })
    .map((file) => file.replace(/\.[^.]+$/, ''))
    .filter((name) => name !== 'default');

  return usernames;
}

let usernames = getAvatarUsernames();
---

<BaseLayout title="首页">
  <SplashScreen />

  <div class="page-content">
    <!-- Hero -->
    <section class="hero-section">
      <div class="hero-logo">
        <Logo width={280} height={280} />
      </div>
      <p class="hero-desc">
        多项特别企划集中开启<br />
        MF 大冲关第四季震撼首映<br />
        MF Direct 作品首发与最新预告<br />
        二十周年贺图与寄语征集同步展开<br />
        更多精彩，邀你回吧见证
      </p>
    </section>

    <!-- 头像墙 -->
    <section class="avatar-section">
      <div class="section-inner">
        <h2 class="section-title">吧友头像墙</h2>
        <p class="section-desc">
          头像为随机选取，大小完全随机，无任何特定暗示或含义；吧友众多，难免存在遗漏，敬请见谅！
        </p>
        <div class="avatar-refresh">
          <button
            id="refresh-avatar-btn"
            class="refresh-btn"
          >
            <svg class="refresh-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
              <path d="M3 3v5h5" />
              <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
              <path d="M16 21h5v-5" />
            </svg>
            <span>换一批</span>
          </button>
        </div>
        {
          usernames.length > 0 ? (
            <div class="avatar-wrapper">
              <AvatarCluster
                usernames={usernames}
                width={1000}
                height={600}
                mobileWidth={360}
                mobileHeight={400}
                mobileMaxAvatars={35}
              />
            </div>
          ) : (
            <div class="card empty-avatars">
              <p class="section-desc">暂无头像数据，请将头像文件放入 public/images/avatars/ 目录</p>
            </div>
          )
        }
      </div>
    </section>

    <!-- 快捷入口 -->
    <section class="quick-links">
      <div class="section-inner">
        <div class="links-grid">
          <a href="/history" class="card link-card">
            <div class="link-icon">📜</div>
            <h3 class="link-title">历史沿革</h3>
            <p class="link-desc">回顾永吧二十年的发展历程</p>
          </a>

          <a href="/messages" class="card link-card">
            <div class="link-icon">💬</div>
            <h3 class="link-title">成员寄语</h3>
            <p class="link-desc">吧友们的心声与祝福</p>
          </a>

          <a href="/direct" class="card link-card">
            <div class="link-icon">🎬</div>
            <h3 class="link-title">MF Direct</h3>
            <p class="link-desc">二十周年直面会</p>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const refreshBtn = document.getElementById('refresh-avatar-btn');
  if (refreshBtn) {
    refreshBtn.addEventListener('click', () => {
      if ((window as any).refreshAvatarWall) {
        (window as any).refreshAvatarWall();
      }
    });
  }
</script>

<style>
  .page-content {
    min-height: 100%;
    padding-top: var(--layout-navbar-height);
  }

  .section-inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: 0 var(--layout-content-padding);
  }

  /* Hero */
  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px var(--layout-content-padding) 24px;
  }

  .hero-logo {
    margin-bottom: 24px;
  }

  .hero-desc {
    max-width: 600px;
    text-align: center;
    font-size: var(--font-size-lg);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  /* Avatar Section */
  .avatar-section {
    padding: 24px 0;
  }

  .section-title {
    text-align: center;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: 6px;
  }

  .section-desc {
    text-align: center;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }

  .avatar-refresh {
    display: flex;
    justify-content: center;
    margin-bottom: 16px;
  }

  .refresh-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-card-bg);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    cursor: pointer;
    transition: all var(--transition-speed) ease;
  }

  .refresh-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .refresh-btn:active {
    transform: scale(0.97);
  }

  .refresh-icon {
    width: 14px;
    height: 14px;
  }

  .avatar-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .empty-avatars {
    text-align: center;
    padding: 24px;
  }

  /* Quick Links */
  .quick-links {
    padding: 24px 0 48px;
  }

  .links-grid {
    display: grid;
    gap: var(--spacing-md);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .links-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .link-card {
    display: block;
    text-align: center;
    text-decoration: none;
    color: inherit;
  }

  .link-card:hover {
    text-decoration: none;
  }

  .link-icon {
    font-size: 2rem;
    margin-bottom: 8px;
  }

  .link-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: 4px;
  }

  .link-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* === 风格覆盖 === */

  /* 复古2006: 紧凑间距，无卡片效果 */
  :global([data-theme="retro"]) .link-card {
    border-radius: 0;
    box-shadow: none;
  }

  :global([data-theme="retro"]) .hero-section {
    padding: 24px var(--layout-content-padding) 12px;
  }

</style>
