---
import BaseLayout from '../layouts/BaseLayout.astro';
import SplashScreen from '../components/SplashScreen.astro';
import AvatarCluster from '../components/AvatarCluster.astro';
import Logo from '../components/Logo.astro';
import { readdirSync, existsSync } from 'fs';
import { join } from 'path';

function getAvatarUsernames(): string[] {
  const avatarsDir = join(process.cwd(), 'public', 'images', 'avatars');

  if (!existsSync(avatarsDir)) {
    return [];
  }

  const files = readdirSync(avatarsDir);
  const imageExtensions = ['.jpg', '.jpeg', '.png', '.webp', '.svg'];

  const usernames = files
    .filter((file) => {
      const ext = file.toLowerCase().slice(file.lastIndexOf('.'));
      return imageExtensions.includes(ext);
    })
    .map((file) => file.replace(/\.[^.]+$/, ''))
    .filter((name) => name !== 'default');

  return usernames;
}

let usernames = getAvatarUsernames();
---

<BaseLayout title="首页">
  <SplashScreen />

  <div class="min-h-screen pt-20">
    <section class="flex flex-col items-center justify-center px-4 pt-16">
      <div class="mb-8">
        <Logo width={280} height={280} />
      </div>
      <p class="mb-8 max-w-2xl text-center text-lg leading-relaxed text-[var(--color-text-secondary)]">
        2006 - 2026，二十年风雨同舟，感谢每一位吧友的陪伴与支持。
      </p>
    </section>

    <section class="relative overflow-hidden px-4 py-8">
      <div class="mx-auto max-w-6xl">
        <h2 class="mb-2 text-center text-2xl font-semibold text-[var(--color-text-primary)]">吧友头像墙</h2>
        <p class="mb-4 text-center text-sm text-[var(--color-text-muted)]">
          头像为随机选取，大小完全随机，无任何特定暗示或含义；吧友众多，难免存在遗漏，敬请见谅！
        </p>
        <div class="mb-6 flex justify-center">
          <button
            id="refresh-avatar-btn"
            class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-secondary)] px-4 py-2 text-sm text-[var(--color-text-secondary)] transition-all hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] active:scale-95"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
              <path d="M3 3v5h5" />
              <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
              <path d="M16 21h5v-5" />
            </svg>
            <span>换一批</span>
          </button>
        </div>
        {
          usernames.length > 0 ? (
            <div class="flex justify-center">
              <AvatarCluster 
                usernames={usernames} 
                width={1000} 
                height={600}
                mobileWidth={360}
                mobileHeight={400}
                mobileMaxAvatars={35}
              />
            </div>
          ) : (
            <div class="rounded-lg bg-[var(--color-bg-secondary)] p-8 text-center">
              <p class="text-[var(--color-text-muted)]">暂无头像数据，请将头像文件放入 public/images/avatars/ 目录</p>
            </div>
          )
        }
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 pt-8 pb-16">
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/history" class="card group p-6 text-center">
          <div class="mb-4 text-4xl drop-shadow-sm">📜</div>
          <h3 class="mb-2 text-lg font-semibold text-[var(--color-text-primary)]">历史沿革</h3>
          <p class="text-sm leading-relaxed text-[var(--color-text-secondary)]">回顾永吧二十年的发展历程</p>
        </a>

        <a href="/messages" class="card group p-6 text-center">
          <div class="mb-4 text-4xl drop-shadow-sm">💬</div>
          <h3 class="mb-2 text-lg font-semibold text-[var(--color-text-primary)]">成员寄语</h3>
          <p class="text-sm leading-relaxed text-[var(--color-text-secondary)]">吧友们的心声与祝福</p>
        </a>

        <a href="/direct" class="card group p-6 text-center">
          <div class="mb-4 text-4xl drop-shadow-sm">🎬</div>
          <h3 class="mb-2 text-lg font-semibold text-[var(--color-text-primary)]">MF Direct</h3>
          <p class="text-sm leading-relaxed text-[var(--color-text-secondary)]">二十周年直面会</p>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const refreshBtn = document.getElementById('refresh-avatar-btn');
  if (refreshBtn) {
    refreshBtn.addEventListener('click', () => {
      if ((window as any).refreshAvatarWall) {
        (window as any).refreshAvatarWall();
      }
    });
  }
</script>
