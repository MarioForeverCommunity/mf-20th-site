---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import YearNav from '../components/YearNav.astro';
import { loadYaml } from '../utils/loadYaml';
import type { HistoryItem, YearInfo } from '../types/history';

const historyItems = await loadYaml<HistoryItem[]>('history.yaml');

const yearCounts: Map<number, number> = new Map();
historyItems.forEach((item: HistoryItem) => {
  yearCounts.set(item.year, (yearCounts.get(item.year) || 0) + 1);
});

const years: YearInfo[] = Array.from(yearCounts.entries()).map(([year, count]) => ({
  year,
  count,
}));
---

<BaseLayout title="历史沿革" description="永远的玛丽吧二十年发展历程">
  <div class="page-content">
    <section class="page-header">
      <div class="section-inner">
        <h1 class="page-title">历史沿革</h1>
      </div>
    </section>

    <section class="timeline-section">
      <Timeline items={historyItems} />
      <YearNav years={years} />
    </section>
  </div>
</BaseLayout>

<style>
  .page-content {
    min-height: 100vh;
    padding-top: var(--layout-navbar-height);
  }

  .section-inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: 0 var(--layout-content-padding);
  }

  .page-header {
    padding: 36px 0;
    text-align: center;
  }

  .page-title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .timeline-section {
    position: relative;
    padding-bottom: 48px;
  }
</style>
