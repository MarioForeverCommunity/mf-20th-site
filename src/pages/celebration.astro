---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="庆典回顾" description="永吧二十周年庆典活动回顾">
  <div class="page-content">
    <section class="page-header">
      <div class="section-inner">
        <h1 class="page-title">庆典回顾</h1>
      </div>
    </section>

    <section class="celebration-section">
      <div class="section-inner">
        <div class="card celebration-card">
          <h2 class="celebration-title">永远的玛丽吧二十周年庆会精彩回顾</h2>
          <iframe
            class="celebration-video"
            src={`//player.bilibili.com/player.html?isOutside=true&aid=117134445452138&bvid=BV15L8B6kEmH&cid=41138720636&p=1&autoplay=0`}
            loading="lazy"
            allowfullscreen
            title="二十周年庆典视频"
          ></iframe>
          <div class="celebration-actions">
            <a href="https://www.bilibili.com/video/BV15L8B6kEmH/" class="btn-primary" target="_blank" rel="noopener noreferrer">查看视频</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-content {
    min-height: 100%;
    padding-top: var(--layout-navbar-height);
  }

  .section-inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: 0 var(--layout-content-padding);
  }

  .page-header {
    padding: 36px 0;
    text-align: center;
  }

  .page-title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 8px;
  }

  .page-desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .celebration-section {
    padding-bottom: 48px;
  }

  .celebration-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xl);
    text-align: center;
  }

  .celebration-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: 20px;
  }

  .celebration-video {
    width: 100%;
    max-width: 960px;
    aspect-ratio: 16 / 9;
    border: none;
    border-radius: var(--radius-md);
    margin-bottom: 20px;
    display: block;
  }

  .celebration-actions {
    display: flex;
    gap: 12px;
  }

  /* === 风格覆盖 === */

  /* 复古2006 */
  :global([data-theme="retro"]) .celebration-card {
    border-radius: 0;
    box-shadow: none;
  }
</style>
