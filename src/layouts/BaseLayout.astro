---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '永远的玛丽吧二十周年纪念专题' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title} | 百度 永远的玛丽吧 二十周年</title>
    <script is:inline>
      (function () {
        // 读取保存的主题风格
        var theme = localStorage.getItem('site-theme');
        if (theme) {
          document.documentElement.dataset.theme = theme;
        } else {
          document.documentElement.dataset.theme = 'modern';
        }
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased relative">
    <Navbar />
    <main class="relative z-0">
      <slot />
    </main>
    <Footer />
  </body>
</html>
