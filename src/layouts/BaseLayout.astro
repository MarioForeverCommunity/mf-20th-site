---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '永远的玛丽吧二十周年纪念专题' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | 百度 永远的玛丽吧 二十周年</title>
    <style is:inline>
      @keyframes liquid {
        0% { transform: translate(0, 0) rotate(0deg); }
        100% { transform: translate(5%, 5%) rotate(5deg); }
      }

      body::before {
        content: '';
        position: fixed;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle at 30% 30%, rgba(0, 113, 227, 0.12) 0%, transparent 45%),
                    radial-gradient(circle at 70% 60%, rgba(239, 68, 68, 0.08) 0%, transparent 45%),
                    radial-gradient(circle at 40% 80%, rgba(0, 113, 227, 0.08) 0%, transparent 45%);
        z-index: -2;
        filter: blur(120px);
        animation: liquid 25s infinite alternate ease-in-out;
        pointer-events: none;
      }

      body::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        opacity: 0.04;
        pointer-events: none;
        mix-blend-mode: overlay;
      }

      :global(.dark) body::after {
        opacity: 0.06;
        mix-blend-mode: soft-light;
      }

      .card {
        background-color: var(--color-bg-secondary);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-glass);
        box-shadow:
          var(--shadow-sm),
          inset 0 1px 0 rgba(255, 255, 255, 0.15),
          inset 0 0 0 1px rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(var(--glass-blur)) saturate(180%);
        -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(180%);
        transition: all 0.5s cubic-bezier(0.28, 0.11, 0.32, 1);
        position: relative;
        overflow: hidden;
      }

      .card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.12) 0%,
          rgba(255, 255, 255, 0) 40%,
          rgba(255, 255, 255, 0) 60%,
          rgba(255, 255, 255, 0.04) 100%
        );
        pointer-events: none;
      }

      .card:hover {
        box-shadow: var(--shadow-md), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        background-color: var(--color-bg-tertiary);
        border-color: rgba(255, 255, 255, 0.5);
      }

      .btn-primary {
        background: linear-gradient(180deg, var(--color-accent-hover) 0%, var(--color-accent) 100%);
        color: white;
        padding: 0.7rem 1.5rem;
        border-radius: 2rem;
        font-weight: 600;
        transition: all 0.4s cubic-bezier(0.28, 0.11, 0.32, 1);
        box-shadow: 0 4px 12px rgba(0, 113, 227, 0.2), 0 8px 24px rgba(0, 113, 227, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(8px);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
      }

      .btn-primary:hover {
        background: linear-gradient(180deg, var(--color-accent) 0%, var(--color-accent-hover) 100%);
        box-shadow: 0 6px 16px rgba(0, 113, 227, 0.25), 0 12px 32px rgba(0, 113, 227, 0.2);
      }

      .link {
        color: var(--color-accent);
        text-decoration: none;
        transition: color 0.2s ease;
        text-underline-offset: 2px;
        text-decoration-thickness: 1px;
      }

      .link:hover {
        color: var(--color-accent-hover);
        text-decoration: underline;
      }
    </style>
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme');
        if (
          theme === 'dark' ||
          (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen font-sans antialiased relative">
    <!-- Background elements -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-20">
      <div class="absolute top-[5%] left-[10%] w-[45vw] h-[45vw] rounded-full bg-blue-400/12 blur-[150px]"></div>
      <div class="absolute bottom-[10%] right-[5%] w-[55vw] h-[55vw] rounded-full bg-red-400/8 blur-[150px]"></div>
      <div class="absolute top-[40%] right-[20%] w-[35vw] h-[35vw] rounded-full bg-purple-400/8 blur-[130px]"></div>
    </div>
    <Navbar />
    <main class="relative z-0">
      <slot />
    </main>
    <Footer />
  </body>
</html>
