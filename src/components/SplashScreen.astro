---
import Logo from './Logo.astro';

interface Props {
  duration?: number;
}

const { duration = 3500 } = Astro.props;
---

<div
  id="splash-screen"
  class="splash-screen"
>
  <div class="splash-content">
    <Logo width={280} height={280} />
  </div>
</div>

<script define:vars={{ duration }}>
  document.addEventListener('DOMContentLoaded', function () {
    const splash = document.getElementById('splash-screen');
    const navbar = document.getElementById('navbar');
    if (!splash) return;

    const url = new URL(window.location.href);
    const showSplash = url.pathname === '/' && url.search === '';

    if (!showSplash) {
      splash.style.display = 'none';
      return;
    }

    if (navbar) {
      navbar.style.opacity = '0';
      navbar.style.pointerEvents = 'none';
    }

    let isDismissed = false;

    const hideSplash = () => {
      if (isDismissed) return;
      isDismissed = true;

      splash.style.transition = 'opacity 0.4s ease';
      splash.style.opacity = '0';

      if (navbar) {
        navbar.style.transition = 'opacity 0.4s ease';
        navbar.style.opacity = '1';
        navbar.style.pointerEvents = '';
      }

      setTimeout(function () {
        splash.style.display = 'none';
      }, 400);
    };

    // 点击立即消失
    splash.addEventListener('click', hideSplash);

    // 自动消失
    setTimeout(hideSplash, duration);
  });
</script>

<style>
  .splash-screen {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg-primary);
    cursor: pointer;
    user-select: none;
  }

  .splash-content {
    animation: splashFadeIn 0.5s ease-out forwards;
  }

  @keyframes splashFadeIn {
    from {
      transform: scale(0.9);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>
