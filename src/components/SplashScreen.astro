---
import Logo from './Logo.astro';

interface Props {
  duration?: number;
}

const { duration = 3500 } = Astro.props;
---

<div
  id="splash-screen"
  class="fixed inset-0 z-[100] flex items-center justify-center bg-[var(--color-bg-primary)]/80 backdrop-blur-2xl cursor-pointer select-none"
>
  <div class="animate-scale-in">
    <Logo width={400} height={400} />
  </div>
</div>

<script define:vars={{ duration }}>
  document.addEventListener('DOMContentLoaded', function () {
    const splash = document.getElementById('splash-screen');
    if (!splash) return;

    const url = new URL(window.location.href);
    const showSplash = url.pathname === '/' && url.search === '';

    if (!showSplash) {
      splash.style.display = 'none';
      return;
    }

    let isDismissed = false;

    const hideSplash = () => {
      if (isDismissed) return;
      isDismissed = true;
      
      splash.style.transition = 'opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), backdrop-filter 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
      splash.style.opacity = '0';
      splash.style.backdropFilter = 'blur(0px)';

      setTimeout(function () {
        splash.style.display = 'none';
      }, 400);
    };

    // 点击立即消失
    splash.addEventListener('click', hideSplash);

    // 自动消失
    setTimeout(hideSplash, duration);
  });
</script>

<style>
  @keyframes scaleIn {
    from {
      transform: scale(0.9);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .animate-scale-in {
    animation: scaleIn 0.5s ease-out forwards;
  }
</style>
