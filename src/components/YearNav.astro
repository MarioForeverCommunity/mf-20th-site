---
import type { YearInfo } from '../types/history';

interface Props {
  years: YearInfo[];
}

const { years } = Astro.props;

const sortedYears = [...years].sort((a, b) => a.year - b.year);
---

<div class="year-nav" id="year-nav">
  <ul class="year-nav-list">
    {
      sortedYears.map((yearInfo) => (
        <li>
          <a
            href={`#year-${yearInfo.year}`}
            class="year-nav-link"
            data-year={yearInfo.year}
          >
            {yearInfo.year}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .year-nav {
    position: fixed;
    right: 20px;
    top: 50%;
    z-index: 30;
    transform: translateY(-50%);
    display: none;
  }

  @media (min-width: 1024px) {
    .year-nav {
      display: block;
    }
  }

  .year-nav-list {
    list-style: none;
    padding: 6px;
    margin: 0;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: center;
  }

  .year-nav-link {
    display: block;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-speed) ease;
  }

  .year-nav-link:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-secondary);
  }

  .year-nav-link.active {
    color: var(--color-accent);
    background: var(--color-bg-tertiary);
  }

  /* === 风格覆盖 === */

  /* 复古2006: 无装饰，方形 */
  :global([data-theme="retro"]) .year-nav-list {
    border-radius: 0;
    box-shadow: none;
  }

  :global([data-theme="retro"]) .year-nav-link {
    border-radius: 0;
  }

  /* 现代2013: 药丸形 */
  :global([data-theme="modern"]) .year-nav-link.active {
    color: #FFFFFF;
    background: var(--color-accent);
    border-radius: var(--radius-full);
  }

  /* 复古2006: 默认隐藏年份导航（该风格的时间线不是左右交替式） */
  :global([data-theme="retro"]) .year-nav {
    display: none;
  }
</style>

<script>
  let isScrolling = false;
  let scrollTimeout: number | null = null;

  function setActiveYear(year: string) {
    const links = document.querySelectorAll('.year-nav-link');
    links.forEach((link) => {
      const isTarget = link.getAttribute('data-year') === year;

      if (isTarget) {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
    });
  }

  function updateActiveYear() {
    if (isScrolling) return;

    const sections = document.querySelectorAll('[id^="year-"]');
    if (sections.length === 0) return;

    const navbarHeight = 64;
    const viewportHeight = window.innerHeight;
    let currentYear: string | null = null;

    for (const section of sections) {
      const rect = section.getBoundingClientRect();
      const isInViewport = rect.top >= navbarHeight && rect.top < viewportHeight;

      if (isInViewport) {
        currentYear = section.id.replace('year-', '');
        break;
      }
    }

    if (currentYear) {
      setActiveYear(currentYear);
    }
  }

  document.querySelectorAll('.year-nav-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      const year = link.getAttribute('data-year');
      if (year) {
        isScrolling = true;
        setActiveYear(year);

        if (scrollTimeout) {
          clearTimeout(scrollTimeout);
        }
        scrollTimeout = window.setTimeout(() => {
          isScrolling = false;
        }, 1000);
      }
    });
  });

  window.addEventListener('scroll', updateActiveYear);
  document.addEventListener('DOMContentLoaded', updateActiveYear);
</script>
