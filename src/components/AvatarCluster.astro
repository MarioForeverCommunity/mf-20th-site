---
interface AvatarItem {
  username: string;
  x: number;
  y: number;
  size: number;
  delay: number;
}

interface Props {
  usernames?: string[];
  width?: number;
  height?: number;
  mobileWidth?: number;
  mobileHeight?: number;
  mobileMaxAvatars?: number;
}

const { 
  usernames = [], 
  width = 800, 
  height = 600,
  mobileWidth = 360,
  mobileHeight = 400,
  mobileMaxAvatars = 35
} = Astro.props;

const MAX_AVATARS = 80;

function generatePuzzlePositions(
  users: string[], 
  containerWidth: number, 
  containerHeight: number,
  minSize: number,
  maxSize: number
): AvatarItem[] {
  const gap = 4;
  const padding = 8;

  const positions: { x: number; y: number; size: number }[] = [];
  const result: AvatarItem[] = [];

  const sizes = users.map(() => minSize + Math.random() * (maxSize - minSize));

  for (let i = 0; i < users.length; i++) {
    const username = users[i];
    const size = sizes[i];
    let placed = false;
    let attempts = 0;
    const maxAttempts = 1000;

    while (!placed && attempts < maxAttempts) {
      const x = padding + Math.random() * (containerWidth - size - padding * 2);
      const y = padding + Math.random() * (containerHeight - size - padding * 2);

      let overlapping = false;
      for (const pos of positions) {
        const rect1 = { left: x - gap, right: x + size + gap, top: y - gap, bottom: y + size + gap };
        const rect2 = { left: pos.x - gap, right: pos.x + pos.size + gap, top: pos.y - gap, bottom: pos.y + pos.size + gap };

        if (rect1.left < rect2.right && rect1.right > rect2.left && rect1.top < rect2.bottom && rect1.bottom > rect2.top) {
          overlapping = true;
          break;
        }
      }

      if (!overlapping) {
        positions.push({ x, y, size });
        result.push({
          username,
          x,
          y,
          size,
          delay: Math.random() * 0.3,
        });
        placed = true;
      }

      attempts++;
    }
  }

  return result;
}

const desktopAvatars = generatePuzzlePositions(
  usernames.slice(0, MAX_AVATARS), 
  width, 
  height,
  30,
  90
);

const mobileAvatars = generatePuzzlePositions(
  usernames.slice(0, mobileMaxAvatars), 
  mobileWidth, 
  mobileHeight,
  24,
  60
);
---

<div
  class="avatar-wall avatar-wall-desktop relative mx-auto rounded-2xl"
  style={`width: ${width}px; height: ${height}px;`}
  id="avatar-wall-container-desktop"
  data-usernames={JSON.stringify(usernames)}
  data-width={width}
  data-height={height}
  data-max-avatars={MAX_AVATARS}
>
  <div class="avatar-wall-bg"></div>
  <div class="avatar-wall-grid"></div>
  <div class="avatar-wall-glow"></div>
  <div class="avatar-wall-dots-minor"></div>
  <div class="avatar-wall-vignette"></div>
  
  {
    desktopAvatars.map((avatar) => (
      <div
        class="avatar-item-wrapper absolute"
        style={`left: ${avatar.x}px; top: ${avatar.y}px; width: ${avatar.size}px; height: ${avatar.size}px;`}
      >
        <div
          class="avatar-item cursor-pointer w-full h-full"
          style={`animation-delay: ${avatar.delay}s;`}
          data-username={avatar.username}
        >
          <img
            src={`/images/avatars/${avatar.username}.jpg`}
            alt={avatar.username}
            class="w-full h-full object-fill"
            loading="lazy"
            onerror="this.src='/images/avatars/default.svg'"
          />
          <div class="avatar-overlay absolute inset-0 opacity-0 transition-opacity duration-200"></div>
        </div>
      </div>
    ))
  }
</div>

<div
  class="avatar-wall avatar-wall-mobile relative mx-auto rounded-2xl"
  style={`width: ${mobileWidth}px; height: ${mobileHeight}px;`}
  id="avatar-wall-container-mobile"
  data-usernames={JSON.stringify(usernames)}
  data-mobile-width={mobileWidth}
  data-mobile-height={mobileHeight}
  data-mobile-max-avatars={mobileMaxAvatars}
>
  <div class="avatar-wall-bg"></div>
  <div class="avatar-wall-grid"></div>
  <div class="avatar-wall-glow"></div>
  <div class="avatar-wall-dots-minor"></div>
  <div class="avatar-wall-vignette"></div>
  
  {
    mobileAvatars.map((avatar) => (
      <div
        class="avatar-item-wrapper absolute"
        style={`left: ${avatar.x}px; top: ${avatar.y}px; width: ${avatar.size}px; height: ${avatar.size}px;`}
      >
        <div
          class="avatar-item cursor-pointer w-full h-full"
          style={`animation-delay: ${avatar.delay}s;`}
          data-username={avatar.username}
        >
          <img
            src={`/images/avatars/${avatar.username}.jpg`}
            alt={avatar.username}
            class="w-full h-full object-fill"
            loading="lazy"
            onerror="this.src='/images/avatars/default.svg'"
          />
          <div class="avatar-overlay absolute inset-0 opacity-0 transition-opacity duration-200"></div>
        </div>
      </div>
    ))
  }
</div>

<!-- Global Tooltip outside the containers to avoid clipping -->
<div id="avatar-global-tooltip" class="fixed z-[100] whitespace-nowrap rounded-lg px-3 py-1.5 text-sm opacity-0 shadow-lg transition-opacity duration-200 pointer-events-none avatar-tooltip"></div>

<style>
  .avatar-wall {
    background: color-mix(in srgb, rgba(255, 255, 255, 0.45) 70%, #0071e3 3%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow:
      inset 0 1px 3px rgb(255 255 255 / 0.2),
      0 14px 30px -15px rgb(0 0 0 / 0.35),
      0 0 0 1px rgba(0, 113, 227, 0.05);
    overflow: hidden;
    isolation: isolate;
    backdrop-filter: blur(20px);
  }

  :global(.dark) .avatar-wall {
    border-color: rgba(255, 255, 255, 0.15);
    background: rgba(20, 20, 25, 0.4);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.08),
      0 14px 30px -12px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(28px);
  }

  .avatar-wall-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 14% 14%, color-mix(in srgb, #0071e3 18%, transparent), transparent 46%),
      radial-gradient(circle at 84% 82%, color-mix(in srgb, #60a5fa 14%, transparent), transparent 50%),
      linear-gradient(138deg, color-mix(in srgb, #ffffff 30%, transparent) 0%, rgba(255, 255, 255, 0.08) 56%, color-mix(in srgb, #ffffff 25%, transparent) 100%);
    opacity: 0.95;
    animation: wallBgShift 18s ease-in-out infinite alternate;
  }

  .avatar-wall-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.18;
    background-image:
      linear-gradient(to right, color-mix(in srgb, rgba(255, 255, 255, 0.4) 50%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, rgba(255, 255, 255, 0.4) 50%, transparent) 1px, transparent 1px);
    background-size: 34px 34px;
    animation: gridFloat 22s linear infinite;
  }

  :global(.dark) .avatar-wall-bg {
    background:
      radial-gradient(circle at 12% 10%, color-mix(in srgb, #0071e3 24%, transparent), transparent 40%),
      radial-gradient(circle at 82% 85%, color-mix(in srgb, #60a5fa 20%, transparent), transparent 44%),
      linear-gradient(135deg, rgba(15, 15, 20, 0.8) 0%, rgba(25, 25, 30, 0.4) 58%, rgba(10, 10, 15, 0.8) 100%);
    opacity: 0.95;
  }

  .avatar-wall-dots-minor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: normal;
    background-image: radial-gradient(circle, color-mix(in srgb, var(--color-text-secondary) 30%, #ffffff 5%) 1.1px, transparent 1.7px);
    background-size: 11px 11px;
    opacity: 0.25;
    animation: dotsMinorMove 12s linear infinite, dotsPulse 4.5s ease-in-out infinite;
  }

  .avatar-wall-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 50%, transparent 60%, rgb(0 0 0 / 0.05) 100%),
      linear-gradient(180deg, rgb(255 255 255 / 0.08), transparent 26%, transparent 74%, rgb(0 0 0 / 0.03));
  }

  @keyframes wallBgShift {
    from {
      transform: scale(1) translate3d(0, 0, 0);
      filter: saturate(1);
    }
    to {
      transform: scale(1.02) translate3d(-8px, -5px, 0);
      filter: saturate(1.04);
    }
  }

  @keyframes gridFloat {
    from {
      background-position: 0 0, 0 0;
    }
    to {
      background-position: 72px 36px, -36px 54px;
    }
  }

  @keyframes dotsMinorMove {
    from {
      background-position: 0 0;
    }
    to {
      background-position: -66px 88px;
    }
  }

  @keyframes dotsPulse {
    0%,
    100% {
      opacity: 0.27;
    }
    50% {
      opacity: 0.42;
    }
  }



  :global(.dark) .avatar-wall-grid {
    opacity: 0.18;
  }

  :global(.dark) .avatar-wall-dots-minor {
    mix-blend-mode: screen;
    background-image: radial-gradient(circle, color-mix(in srgb, var(--color-text-muted) 45%, #ffffff 35%) 1px, transparent 1.6px);
    opacity: 0.2;
  }

  :global(.dark) .avatar-wall-vignette {
    background:
      radial-gradient(circle at 50% 50%, transparent 56%, rgb(0 0 0 / 0.18) 100%),
      linear-gradient(180deg, rgb(255 255 255 / 0.08), transparent 24%, transparent 76%, rgb(0 0 0 / 0.08));
  }

  .avatar-wall-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        color-mix(in srgb, #818cf8 24%, transparent) 0%,
        color-mix(in srgb, #60a5fa 12%, transparent) 22%,
        transparent 54%
      ),
      radial-gradient(
        circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        color-mix(in srgb, #ffffff 18%, transparent) 0%,
        transparent 32%
      );
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .avatar-wall:hover .avatar-wall-glow {
    opacity: 1;
  }

  :global(.avatar-item-wrapper) {
    overflow: visible;
  }

  :global(.avatar-item) {
    animation: fadeInAvatar 0.5s ease-out forwards;
    opacity: 0;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.dark .avatar-item) {
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);
  }

  @keyframes fadeInAvatar {
    from {
      opacity: 0;
      transform: scale(0.85);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  :global(.avatar-overlay) {
    background: linear-gradient(to bottom, transparent 60%, rgba(0, 0, 0, 0.2));
  }

  :global(.avatar-item:hover .avatar-overlay) {
    opacity: 0.3;
  }

  :global(.avatar-item:hover) {
    z-index: 10;
    border-color: rgba(255, 255, 255, 0.4);
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.15);
  }

  .avatar-tooltip {
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    transform: translateX(-50%);
  }

  :global(.dark) .avatar-tooltip {
    background: rgba(30, 30, 30, 0.8);
    border-color: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .avatar-tooltip.visible {
    opacity: 1;
  }

  .avatar-tooltip.tooltip-up {
    transform: translate(-50%, -100%);
  }

  .avatar-wall-desktop {
    display: block;
  }

  .avatar-wall-mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .avatar-wall-desktop {
      display: none;
    }

    .avatar-wall-mobile {
      display: block;
    }
  }
</style>

<script>
  interface AvatarItem {
    username: string;
    x: number;
    y: number;
    size: number;
    delay: number;
  }

  function generatePuzzlePositions(
    users: string[], 
    containerWidth: number, 
    containerHeight: number,
    minSize: number,
    maxSize: number
  ): AvatarItem[] {
    const gap = 4;
    const padding = 8;
    const positions: { x: number; y: number; size: number }[] = [];
    const result: AvatarItem[] = [];
    const sizes = users.map(() => minSize + Math.random() * (maxSize - minSize));

    for (let i = 0; i < users.length; i++) {
      const username = users[i];
      const size = sizes[i];
      let placed = false;
      let attempts = 0;
      const maxAttempts = 1000;

      while (!placed && attempts < maxAttempts) {
        const x = padding + Math.random() * (containerWidth - size - padding * 2);
        const y = padding + Math.random() * (containerHeight - size - padding * 2);

        let overlapping = false;
        for (const pos of positions) {
          const rect1 = { left: x - gap, right: x + size + gap, top: y - gap, bottom: y + size + gap };
          const rect2 = { left: pos.x - gap, right: pos.x + pos.size + gap, top: pos.y - gap, bottom: pos.y + pos.size + gap };

          if (rect1.left < rect2.right && rect1.right > rect2.left && rect1.top < rect2.bottom && rect1.bottom > rect2.top) {
            overlapping = true;
            break;
          }
        }

        if (!overlapping) {
          positions.push({ x, y, size });
          result.push({
            username,
            x,
            y,
            size,
            delay: Math.random() * 0.3,
          });
          placed = true;
        }
        attempts++;
      }
    }
    return result;
  }

  const globalTooltip = document.getElementById('avatar-global-tooltip');

  function initAvatarWall(containerId: string) {
    const container = document.getElementById(containerId);
    if (!container) return;

    // 1. 获取并处理数据
    const usernamesStr = container.getAttribute('data-usernames') || '[]';
    let usernames = JSON.parse(usernamesStr);
    if (usernames.length === 0) return;

    const isMobile = containerId.includes('mobile');
    const width = parseInt(container.getAttribute(isMobile ? 'data-mobile-width' : 'data-width') || (isMobile ? '360' : '1000'));
    const height = parseInt(container.getAttribute(isMobile ? 'data-mobile-height' : 'data-height') || (isMobile ? '400' : '600'));
    const maxAvatars = parseInt(container.getAttribute(isMobile ? 'data-mobile-max-avatars' : 'data-max-avatars') || (isMobile ? '35' : '80'));
    const minSize = isMobile ? 24 : 30;
    const maxSize = isMobile ? 60 : 90;

    // 2. 随机洗牌并截取
    usernames = usernames.sort(() => Math.random() - 0.5).slice(0, maxAvatars);
    
    // 3. 生成位置
    const avatars = generatePuzzlePositions(usernames, width, height, minSize, maxSize);

    // 4. 清理现有的头像元素（保留背景、网格等层）
    const existingWrappers = container.querySelectorAll('.avatar-item-wrapper');
    existingWrappers.forEach(el => el.remove());

    // 5. 渲染新头像
    avatars.forEach(avatar => {
      const wrapper = document.createElement('div');
      wrapper.className = 'avatar-item-wrapper absolute';
      wrapper.style.cssText = `left: ${avatar.x}px; top: ${avatar.y}px; width: ${avatar.size}px; height: ${avatar.size}px;`;
      
      wrapper.innerHTML = `
        <div class="avatar-item cursor-pointer w-full h-full" style="animation-delay: ${avatar.delay}s;" data-username="${avatar.username}">
          <img
            src="/images/avatars/${avatar.username}.jpg"
            alt="${avatar.username}"
            class="w-full h-full object-fill"
            loading="lazy"
          />
          <div class="avatar-overlay absolute inset-0 opacity-0 transition-opacity duration-200"></div>
        </div>
      `;

      const img = wrapper.querySelector('img');
      if (img) {
        img.onerror = () => { img.src = '/images/avatars/default.svg'; };
      }

      container.appendChild(wrapper);
    });
    
    const avatarItems = Array.from(container.querySelectorAll<HTMLElement>('.avatar-item'));
    const glow = container.querySelector('.avatar-wall-glow') as HTMLElement;

    function updateTooltipPosition(item: HTMLElement) {
      if (!globalTooltip) return;

      const username = item.getAttribute('data-username');
      if (!username) return;

      globalTooltip.textContent = username;
      const rect = item.getBoundingClientRect();

      const left = rect.left + rect.width / 2;
      const top = rect.bottom + 8;

      const viewportWidth = window.innerWidth;
      const viewportHeight = window.innerHeight;

      globalTooltip.classList.remove('tooltip-up');
      
      // Initial positioning to get size
      globalTooltip.style.left = `${left}px`;
      globalTooltip.style.top = `${top}px`;
      
      const tooltipRect = globalTooltip.getBoundingClientRect();
      let finalLeft = left;
      let finalTop = top;

      // Horizontal bounds
      if (finalLeft - tooltipRect.width / 2 < 8) {
        finalLeft = tooltipRect.width / 2 + 8;
      } else if (finalLeft + tooltipRect.width / 2 > viewportWidth - 8) {
        finalLeft = viewportWidth - tooltipRect.width / 2 - 8;
      }

      // Vertical bounds (if at bottom, show above)
      if (finalTop + tooltipRect.height > viewportHeight - 8) {
        finalTop = rect.top - 8;
        globalTooltip.classList.add('tooltip-up');
      }

      globalTooltip.style.left = `${finalLeft}px`;
      globalTooltip.style.top = `${finalTop}px`;
      globalTooltip.classList.add('visible');
    }

    function hideTooltip() {
      if (globalTooltip) {
        globalTooltip.classList.remove('visible');
      }
    }

    function updateGlow(e: MouseEvent) {
      if (!container || !glow) return;
      
      const rect = container.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      
      container.style.setProperty('--mouse-x', `${x}%`);
      container.style.setProperty('--mouse-y', `${y}%`);
    }

    avatarItems.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        updateTooltipPosition(item);
      });

      item.addEventListener('mouseleave', hideTooltip);

      item.addEventListener('click', (e) => {
        e.stopPropagation();
        updateTooltipPosition(item);
      });
    });

    container.addEventListener('mousemove', updateGlow);
    container.addEventListener('mouseleave', () => {
      if (glow) {
        glow.style.opacity = '0';
      }
      hideTooltip();
    });
    container.addEventListener('mouseenter', () => {
      if (glow) {
        glow.style.opacity = '1';
      }
    });
  }

  // Expose refresh function to global scope
  (window as any).refreshAvatarWall = () => {
    initAvatarWall('avatar-wall-container-desktop');
    initAvatarWall('avatar-wall-container-mobile');
  };

  initAvatarWall('avatar-wall-container-desktop');
  initAvatarWall('avatar-wall-container-mobile');

  // Hide tooltip on scroll or click elsewhere
  window.addEventListener('scroll', () => {
    const globalTooltip = document.getElementById('avatar-global-tooltip');
    globalTooltip?.classList.remove('visible');
  }, { passive: true });

  document.addEventListener('click', () => {
    const globalTooltip = document.getElementById('avatar-global-tooltip');
    globalTooltip?.classList.remove('visible');
  });
</script>
