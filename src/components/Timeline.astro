---
import type { HistoryItem } from '../types/history';
import TimelineCard from './TimelineCard.astro';
import ImageLightbox from './ImageLightbox.astro';

interface Props {
  items: HistoryItem[];
}

const { items } = Astro.props;

const sortedItems = [...items].sort((a, b) => a.year - b.year);

const processedItems = sortedItems.map((item, index) => {
  const isFirstOfYear = index === 0 || sortedItems[index - 1].year !== item.year;
  return { ...item, isFirstOfYear };
});
---

<div class="timeline-container">
  <div class="timeline-line"></div>

  <div class="timeline-items">
    {
      processedItems.map((item, index) => {
        const isLeft = index % 2 === 0;
        const isLast = index === processedItems.length - 1;
        return (
          <div class:list={['timeline-item-wrapper', isLast && 'timeline-item-last']} id={`year-${item.year}`}>
            <TimelineCard item={item} isLeft={isLeft} index={index} showYear={item.isFirstOfYear} isLast={isLast} />
          </div>
        );
      })
    }
  </div>
</div>

<!-- 图片点击放大 -->
<ImageLightbox selectors=".timeline-img, .thumb-img" />

<style>
  /* ===== Base container styles ===== */
  .timeline-container {
    position: relative;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: var(--spacing-xl) var(--layout-content-padding);
  }

  .timeline-line {
    display: none;
  }

  .timeline-item-wrapper {
    position: relative;
    margin-bottom: var(--spacing-md);
  }

  /* ===== retro: Simple list, no timeline line ===== */
  :global([data-theme="retro"]) .timeline-item-wrapper {
    margin-bottom: 0;
  }

  /* ===== modern: Card flow (mobile) / Alternating timeline with center line (desktop) ===== */
  :global([data-theme="modern"]) .timeline-item-wrapper {
    margin-bottom: var(--spacing-lg);
  }

  @media (min-width: 768px) {
    :global([data-theme="modern"]) .timeline-container {
      padding-top: 8rem;
    }

    :global([data-theme="modern"]) .timeline-line {
      display: block;
      position: absolute;
      top: -16px;
      bottom: 0;
      height: auto;
      width: 2px;
      background-color: var(--color-accent);
      opacity: 0.4;
      left: 50%;
      transform: translateX(-50%);
    }

    :global([data-theme="modern"]) .timeline-items {
      padding-top: 10px;
    }

    :global([data-theme="modern"]) .timeline-item-wrapper {
      height: 220px;
      min-height: unset;
      margin-bottom: 0;
      overflow: visible;
    }

    :global([data-theme="modern"]) .timeline-item-last {
      height: auto;
    }
  }
</style>
