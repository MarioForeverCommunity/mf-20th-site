---
import type { HistoryItem } from '../types/history';
import TimelineCard from './TimelineCard.astro';

interface Props {
  items: HistoryItem[];
}

const { items } = Astro.props;

const sortedItems = [...items].sort((a, b) => a.year - b.year);

const processedItems = sortedItems.map((item, index) => {
  const isFirstOfYear = index === 0 || sortedItems[index - 1].year !== item.year;
  return { ...item, isFirstOfYear };
});
---

<div class="timeline-container">
  <div class="timeline-line"></div>

  <div class="timeline-items">
    {
      processedItems.map((item, index) => {
        const isLeft = index % 2 === 0;
        const isLast = index === processedItems.length - 1;
        return (
          <div class:list={['timeline-item-wrapper', isLast && 'timeline-item-last']} id={`year-${item.year}`}>
            <TimelineCard item={item} isLeft={isLeft} index={index} showYear={item.isFirstOfYear} isLast={isLast} />
          </div>
        );
      })
    }
  </div>
</div>

<!-- Image modal (one instance for the whole timeline) -->
<div id="image-modal" class="image-modal">
  <img id="modal-image" src="" alt="" class="modal-image" />
</div>

<style>
  /* ===== Base container styles ===== */
  .timeline-container {
    position: relative;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: var(--spacing-xl) var(--layout-content-padding);
  }

  .timeline-line {
    display: none;
  }

  .timeline-item-wrapper {
    position: relative;
    margin-bottom: var(--spacing-md);
  }

  /* ===== retro: Simple list, no timeline line ===== */
  :global([data-theme="retro"]) .timeline-item-wrapper {
    margin-bottom: 0;
  }

  /* ===== modern: Card flow (mobile) / Alternating timeline with center line (desktop) ===== */
  :global([data-theme="modern"]) .timeline-item-wrapper {
    margin-bottom: var(--spacing-lg);
  }

  @media (min-width: 768px) {
    :global([data-theme="modern"]) .timeline-container {
      padding-top: 8rem;
    }

    :global([data-theme="modern"]) .timeline-line {
      display: block;
      position: absolute;
      top: -16px;
      bottom: 0;
      height: auto;
      width: 2px;
      background-color: var(--color-accent);
      opacity: 0.4;
      left: 50%;
      transform: translateX(-50%);
    }

    :global([data-theme="modern"]) .timeline-items {
      padding-top: 10px;
    }

    :global([data-theme="modern"]) .timeline-item-wrapper {
      height: 220px;
      min-height: unset;
      margin-bottom: 0;
      overflow: visible;
    }

    :global([data-theme="modern"]) .timeline-item-last {
      height: auto;
    }
  }

  /* ===== Image modal ===== */
  .image-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xl);
    background-color: color-mix(in srgb, var(--color-bg-primary) 90%, transparent);
  }

  .image-modal.active {
    display: flex;
  }

  .modal-image {
    max-height: 90vh;
    max-width: 90vw;
    border-radius: var(--radius-xl);
    object-fit: contain;
    box-shadow: var(--shadow-lg);
  }
</style>

<script>
  const modal = document.getElementById('image-modal');
  const modalImage = document.getElementById('modal-image') as HTMLImageElement;

  // 监听时间线图片和缩略图的点击
  document.querySelectorAll('.timeline-img, .thumb-img').forEach((img) => {
    img.addEventListener('click', () => {
      if (modal && modalImage) {
        modalImage.src = (img as HTMLImageElement).src;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  function closeModal() {
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal();
    }
  });
</script>
