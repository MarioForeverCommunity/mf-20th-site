---
import type { HistoryItem } from '../types/history';
import TimelineCard from './TimelineCard.astro';

interface Props {
  items: HistoryItem[];
}

const { items } = Astro.props;

const sortedItems = [...items].sort((a, b) => a.year - b.year);

const processedItems = sortedItems.map((item, index) => {
  const isFirstOfYear = index === 0 || sortedItems[index - 1].year !== item.year;
  return { ...item, isFirstOfYear };
});
---

<div class="timeline-container relative mx-auto max-w-4xl px-4 py-8 lg:max-w-6xl">
  <div class="timeline-line absolute top-0 h-full w-1 bg-[var(--color-accent)] opacity-40 dark:opacity-60 md:top-[-40px] md:h-[calc(100%+40px)] shadow-[0_0_20px_rgba(59,130,246,0.6)] rounded-t-full"></div>

  <div class="timeline-items">
    {
      processedItems.map((item, index) => {
        const isLeft = index % 2 === 0;
        const isLast = index === processedItems.length - 1;
        return (
          <div class:list={['timeline-item-wrapper', isLast && 'timeline-item-last']} id={`year-${item.year}`}>
            <TimelineCard item={item} isLeft={isLeft} index={index} showYear={item.isFirstOfYear} isLast={isLast} />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .timeline-item-wrapper {
    min-height: 3rem;
    margin-bottom: 3rem;
    position: relative;
  }

  @media (min-width: 768px) {
    .timeline-item-wrapper {
      height: 180px;
      min-height: unset;
      margin-bottom: 0;
      position: relative;
      overflow: visible;
    }

    .timeline-item-last {
      margin-top: 60px;
    }
  }

  @media (min-width: 1024px) {
    .timeline-item-wrapper {
      height: 220px;
    }
  }

  @media (max-width: 768px) {
    .timeline-line {
      left: 32px;
      transform: translateX(-50%);
    }
  }

  @media (min-width: 768px) {
    .timeline-line {
      left: calc(50% - 0.25px);
      transform: translateX(-50%);
    }
  }
</style>
