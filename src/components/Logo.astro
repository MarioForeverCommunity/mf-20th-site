---
interface Props {
  width?: number;
  height?: number;
  class?: string;
}

const { width = 200, height = 200, class: className = '' } = Astro.props;
---

<div
  class:list={["logo-container", className]}
  style={`width: ${width}px;`}
>
  <img
    src="/images/logo/mfbarlogo.png"
    alt="MF Bar Logo"
    class="logo-image"
    style={`max-width: ${width}px;`}
  />

  <div class="logo-text">
    <span class="logo-title">二十周年</span>
    <span class="logo-subtitle">2006 - 2026</span>
  </div>
</div>

<style>
  .logo-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .logo-image {
    width: 100%;
    height: auto;
    transition: all var(--transition-speed) ease;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }

  .logo-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.15em;
    color: var(--color-accent);
  }

  .logo-subtitle {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }
</style>
