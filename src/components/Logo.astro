---
interface Props {
  width?: number;
  height?: number;
  class?: string;
}

const { width = 200, height = 200, class: className = '' } = Astro.props;
---

<div 
  class:list={["flex flex-col items-center justify-center space-y-3", className]}
  style={`width: ${width}px;`}
>
  <img 
    src="/images/logo/mfbarlogo.png" 
    alt="MF Bar Logo" 
    class="w-full h-auto drop-shadow-lg transition-all duration-300 dark:brightness-110"
    style={`max-width: ${width}px;`}
  />
  
  <div class="flex flex-col items-center space-y-1 text-center">
    <span class="text-2xl font-bold tracking-[0.3em] bg-gradient-to-r from-[var(--color-accent)] to-blue-400 bg-clip-text text-transparent">
      二十周年
    </span>
    <span class="text-sm font-medium tracking-widest text-[var(--color-text-secondary)] opacity-80 dark:text-white/60">
      2006 - 2026
    </span>
  </div>
</div>

<style>
  /* 这里的样式主要由 Tailwind 处理，如果需要特殊的滤镜效果可以在此添加 */
</style>
