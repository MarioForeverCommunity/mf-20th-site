---
interface Props {
  width?: number;
  height?: number;
  class?: string;
}

const { width = 200, height = 200, class: className = '' } = Astro.props;
const gradientId = `logo-gradient-${Math.random().toString(36).slice(2, 10)}`;
---

<svg
  viewBox="0 0 200 200"
  width={width}
  height={height}
  class={className}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={gradientId} x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="var(--logo-gradient-start)" />
      <stop offset="100%" stop-color="var(--logo-gradient-end)" />
    </linearGradient>
  </defs>

  <circle cx="100" cy="100" r="90" fill={`url(#${gradientId})`} />
  <circle cx="100" cy="100" r="80" fill="none" stroke="white" stroke-width="2" opacity="0.3" />

  <text
    x="100"
    y="85"
    text-anchor="middle"
    font-family="Inter, system-ui, sans-serif"
    font-size="48"
    font-weight="700"
    fill="white"
  >
    永吧
  </text>

  <text
    x="100"
    y="120"
    text-anchor="middle"
    font-family="Inter, system-ui, sans-serif"
    font-size="20"
    font-weight="600"
    fill="white"
    opacity="0.9"
  >
    20th Anniversary
  </text>

  <text
    x="100"
    y="150"
    text-anchor="middle"
    font-family="Inter, system-ui, sans-serif"
    font-size="14"
    font-weight="500"
    fill="white"
    opacity="0.7"
  >
    2006 - 2026
  </text>
</svg>

<style>
  :global(:root) {
    --logo-gradient-start: #dc2626;
    --logo-gradient-end: #991b1b;
  }

  :global(.dark) {
    --logo-gradient-start: #f87171;
    --logo-gradient-end: #dc2626;
  }
</style>
