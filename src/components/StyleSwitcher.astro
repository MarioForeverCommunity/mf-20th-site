---
/* 风格切换器组件 */
---

<div id="style-switcher" class="style-switcher">
  <button
    id="style-switcher-btn"
    type="button"
    class="style-switcher-trigger"
    aria-label="切换风格"
    aria-expanded="false"
  >
    <svg class="style-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3a9 9 0 0 0 9 9 9 9 0 0 0-9 9 9 9 0 0 0-9-9 9 9 0 0 0 9-9z" />
    </svg>
    <span class="style-label" id="current-style-label">默认</span>
    <svg class="style-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </button>

  <div id="style-switcher-dropdown" class="style-dropdown">
    <div class="style-dropdown-inner">
      <button class="style-option" data-theme-value="modern">
        <span class="style-option-dot" style="background: #4E71F2;"></span>
        <span class="style-option-text">
          <span class="style-option-name">默认</span>
          <span class="style-option-desc">二十周年风格</span>
        </span>
      </button>
      <button class="style-option" data-theme-value="retro">
        <span class="style-option-dot" style="background: #0000cc;"></span>
        <span class="style-option-text">
          <span class="style-option-name">复古</span>
          <span class="style-option-desc">早期贴吧风格</span>
        </span>
      </button>
    </div>
  </div>
</div>

<style>
  .style-switcher {
    position: relative;
  }

  .style-switcher-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-card-bg);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    cursor: pointer;
    transition: all var(--transition-speed) ease;
    white-space: nowrap;
  }

  .style-switcher-trigger:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent);
  }

  .style-icon {
    width: 16px;
    height: 16px;
  }

  .style-arrow {
    width: 12px;
    height: 12px;
    transition: transform var(--transition-speed) ease;
  }

  .style-switcher-trigger[aria-expanded="true"] .style-arrow {
    transform: rotate(180deg);
  }

  .style-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 100;
    min-width: 180px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity var(--transition-speed) ease, transform var(--transition-speed) ease, visibility var(--transition-speed) ease;
  }

  .style-switcher.open .style-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .style-dropdown-inner {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 4px;
    overflow: hidden;
  }

  .style-option {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 10px;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-primary);
    cursor: pointer;
    text-align: left;
    transition: background-color var(--transition-speed) ease;
  }

  .style-option:hover {
    background: var(--color-bg-secondary);
  }

  .style-option.active {
    background: var(--color-bg-tertiary);
  }

  .style-option-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .style-option-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .style-option-name {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .style-option-desc {
    font-size: 11px;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .style-label {
      display: none;
    }
  }
</style>

<script>
  const styleLabels: Record<string, string> = {
    'retro': '复古',
    'modern': '默认',
  };

  const switcher = document.getElementById('style-switcher');
  const trigger = document.getElementById('style-switcher-btn');
  const label = document.getElementById('current-style-label');
  const options = document.querySelectorAll('.style-option');

  function getCurrentTheme(): string {
    return document.documentElement.dataset.theme || 'modern';
  }

  function updateActiveOption() {
    const current = getCurrentTheme();
    options.forEach((opt) => {
      const value = opt.getAttribute('data-theme-value');
      if (value === current) {
        opt.classList.add('active');
      } else {
        opt.classList.remove('active');
      }
    });
    if (label) {
      label.textContent = styleLabels[current] || '默认';
    }
  }

  function closeDropdown() {
    switcher?.classList.remove('open');
    trigger?.setAttribute('aria-expanded', 'false');
  }

  function openDropdown() {
    switcher?.classList.add('open');
    trigger?.setAttribute('aria-expanded', 'true');
  }

  trigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = switcher?.classList.contains('open');
    if (isOpen) {
      closeDropdown();
    } else {
      openDropdown();
    }
  });

  options.forEach((opt) => {
    opt.addEventListener('click', () => {
      const value = opt.getAttribute('data-theme-value');
      if (!value) return;

      // 设置主题
      document.documentElement.dataset.theme = value;
      localStorage.setItem('site-theme', value);

      updateActiveOption();
      closeDropdown();
    });
  });

  // 点击外部关闭
  document.addEventListener('click', (e) => {
    if (switcher && !switcher.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  // ESC关闭
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDropdown();
    }
  });

  updateActiveOption();
</script>
