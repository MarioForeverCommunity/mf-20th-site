---
import StyleSwitcher from './StyleSwitcher.astro';

const navItems = [
  { href: '/', label: '首页' },
  { href: '/history', label: '历史沿革' },
  { href: '/messages', label: '贺图寄语' },
  { href: '/celebration', label: '庆典回顾' },
  { href: '/direct', label: 'MF Direct' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header id="navbar" class="navbar">
  <nav class="navbar-inner">
    <!-- Logo / 站点名称 -->
    <div class="navbar-brand">
      <a href="/" class="navbar-logo">永吧二十周年</a>
    </div>

    <!-- 导航链接 -->
    <div class="navbar-links" id="nav-links">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'navbar-link',
              currentPath === item.href && 'active',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <!-- 右侧操作区 -->
    <div class="navbar-actions">
      <StyleSwitcher />
      <button
        id="mobile-menu-btn"
        type="button"
        class="navbar-mobile-btn"
        aria-label="打开菜单"
      >
        <svg class="menu-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="menu-icon">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- 移动端菜单 -->
  <div id="mobile-menu" class="mobile-menu">
    <div class="mobile-menu-inner">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'mobile-link',
              currentPath === item.href && 'active',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--color-nav-bg);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .navbar-inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--layout-navbar-height);
    padding: 0 var(--layout-content-padding);
  }

  .navbar-brand {
    flex-shrink: 0;
  }

  .navbar-logo {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-nav-text);
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: 0.15em;
  }

  .navbar-links {
    display: none;
    align-items: center;
    gap: 2px;
  }

  @media (min-width: 768px) {
    .navbar-links {
      display: flex;
    }
  }

  .navbar-link {
    padding: 6px 14px;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-nav-text);
    border-radius: var(--radius-md);
    text-decoration: none;
    white-space: nowrap;
    transition: all var(--transition-speed) ease;
    opacity: 0.85;
  }

  .navbar-link:hover {
    opacity: 1;
  }

  .navbar-link.active {
    opacity: 1;
    background: var(--color-nav-active-bg);
    color: var(--color-nav-text);
  }

  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .navbar-mobile-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-nav-text);
    cursor: pointer;
  }

  .menu-icon {
    width: 20px;
    height: 20px;
  }

  @media (min-width: 768px) {
    .navbar-mobile-btn {
      display: none;
    }
  }

  .mobile-menu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-in-out;
  }

  .mobile-menu-inner {
    padding: 8px var(--layout-content-padding) 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mobile-link {
    display: block;
    padding: 10px 12px;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-nav-text);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-speed) ease;
    opacity: 0.85;
  }

  .mobile-link:hover,
  .mobile-link.active {
    opacity: 1;
    background: var(--color-nav-active-bg);
  }

  /* === 风格特定覆盖 === */

  /* 复古2006: 蓝色渐变导航条 */
  :global([data-theme="retro"]) .navbar {
    background: linear-gradient(180deg, var(--color-nav-bg) 0%, var(--color-nav-bg-end) 100%);
    border-bottom: none;
    box-shadow: none;
  }

  :global([data-theme="retro"]) .navbar-link.active {
    background: rgba(255, 255, 255, 0.2);
  }

  :global([data-theme="retro"]) .navbar-link:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  :global([data-theme="retro"]) .mobile-link.active {
    background: rgba(255, 255, 255, 0.2);
  }

  /* 复刻 2013: 白底蓝色文字，下划线高亮 */
  :global([data-theme="modern"]) .navbar {
    box-shadow: none;
  }

  :global([data-theme="modern"]) .navbar-logo {
    letter-spacing: 0.1em;
  }

  :global([data-theme="modern"]) .navbar-link {
    color: var(--color-accent);
    opacity: 0.8;
  }

  :global([data-theme="modern"]) .navbar-link:hover {
    opacity: 1;
  }

  :global([data-theme="modern"]) .navbar-link.active {
    color: var(--color-accent);
    background: transparent;
    opacity: 1;
    font-weight: var(--font-weight-semibold);
    border-bottom: 2px solid var(--color-accent);
    border-radius: 0;
  }

  :global([data-theme="modern"]) .mobile-link.active {
    color: var(--color-accent);
    background: transparent;
  }

  :global([data-theme="modern"]) .mobile-link:hover {
    background: var(--color-bg-tertiary);
  }

  :global([data-theme="modern"]) .mobile-menu-inner {
    border-top: 1px solid var(--color-border);
  }


</style>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  mobileMenuBtn?.addEventListener('click', function () {
    if (mobileMenu) {
      const isExpanded = mobileMenu.style.maxHeight && mobileMenu.style.maxHeight !== '0px';

      if (isExpanded) {
        mobileMenu.style.maxHeight = '0px';
        if (menuIcon) {
          menuIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
        }
      } else {
        mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
        if (menuIcon) {
          menuIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />';
        }
      }
    }
  });

  // 非移动端时自动收起移动端菜单
  const desktopQuery = window.matchMedia('(min-width: 768px)');
  function closeMobileMenu() {
    if (mobileMenu) {
      mobileMenu.style.maxHeight = '0px';
    }
    if (menuIcon) {
      menuIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
    }
  }
  desktopQuery.addEventListener('change', (e) => {
    if (e.matches) closeMobileMenu();
  });
</script>
