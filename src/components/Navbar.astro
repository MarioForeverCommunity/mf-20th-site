---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/', label: '首页' },
  { href: '/history', label: '历史沿革' },
  { href: '/messages', label: '成员寄语' },
  { href: '/works', label: '二十周年档' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<div id="navbar" class="fixed top-6 left-0 right-0 z-50 px-4 sm:px-6 lg:px-8 pointer-events-none">
  <nav class="mx-auto max-w-6xl card pointer-events-auto !bg-[var(--color-bg-secondary)]/30 !rounded-[2rem] !py-1.5 !px-1.5 border border-black/5 dark:border-white/20 shadow-2xl transition-all duration-500 hover:!transform-none" id="main-nav">
    <div class="flex h-11 items-center justify-between relative">
      <!-- Left part: Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center space-x-2 pl-4 pr-2 group">
          <span class="text-xl font-bold tracking-[0.1em] bg-gradient-to-r from-[var(--color-accent)] to-blue-400 bg-clip-text text-transparent opacity-100 transition-opacity">永吧二十周年</span>
        </a>
      </div>

      <!-- Center part: Nav Items (Absolutely Centered) -->
      <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 items-center space-x-1">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-full px-4 py-1.5 text-sm font-medium transition-all duration-300 relative group whitespace-nowrap',
                currentPath === item.href
                  ? 'bg-white/60 dark:bg-white/10 text-[var(--color-text-primary)] shadow-[inset_0_1px_3px_rgba(255,255,255,0.68),0_6px_16px_rgba(0,0,0,0.14)] border border-white/70 dark:border-white/15 backdrop-blur-md'
                  : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:scale-100',
              ]}
            >
              <span class="relative z-10 inline-block">{item.label}</span>
              {currentPath !== item.href && (
                <span class="absolute inset-0 rounded-full bg-white/0 border border-transparent backdrop-blur-none transition-all duration-300 group-hover:bg-white/15 dark:group-hover:bg-white/10 group-hover:backdrop-blur-[10px] group-hover:border-white/25 dark:group-hover:border-white/15 group-hover:shadow-sm"></span>
              )}
            </a>
          ))
        }
      </div>

      <!-- Right part: Actions -->
      <div class="flex items-center space-x-1 pr-1 pl-2 ml-auto">
        <div class="flex items-center space-x-1 border-l border-white/10 pl-2">
          <ThemeToggle />

          <button
            id="mobile-menu-btn"
            type="button"
            class="rounded-full p-2 text-[var(--color-text-secondary)] hover:bg-white/20 md:hidden transition-colors active:scale-100"
            aria-label="打开菜单"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="menu-icon">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div id="mobile-menu" class="max-h-0 md:hidden overflow-hidden transition-all duration-500 ease-in-out">
      <div class="space-y-2 px-2 py-2 mt-2 border-t border-white/10">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'block rounded-2xl px-4 py-2 text-base font-medium transition-all duration-300 relative overflow-hidden',
                currentPath === item.href
                  ? 'bg-white/60 dark:bg-white/10 text-[var(--color-text-primary)] shadow-[inset_0_1px_3px_rgba(255,255,255,0.62),0_4px_14px_rgba(0,0,0,0.12)] border border-white/65 dark:border-white/15 backdrop-blur-md'
                  : 'text-[var(--color-text-secondary)] hover:bg-white/10 dark:hover:bg-white/5 hover:text-[var(--color-text-primary)]',
              ]}
            >
              <span class="relative z-10">{item.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</div>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  mobileMenuBtn?.addEventListener('click', function () {
    if (mobileMenu) {
      const isExpanded = mobileMenu.style.maxHeight && mobileMenu.style.maxHeight !== '0px';
      
      if (isExpanded) {
        mobileMenu.style.maxHeight = '0px';
        if (menuIcon) {
          menuIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
        }
      } else {
        mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
        if (menuIcon) {
          menuIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />';
        }
      }
    }
  });
</script>
