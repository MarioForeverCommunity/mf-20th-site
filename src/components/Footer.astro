---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<footer class:list={['site-footer', className]}>
  <div class="footer-inner">
    <p class="footer-text">
      <span>&copy; 2006-2026</span>
      <a href="https://tieba.baidu.com/f?kw=%E6%B0%B8%E8%BF%9C%E7%9A%84%E7%8E%9B%E4%B8%BD" target="_blank" rel="noopener noreferrer">百度永远的玛丽吧</a>
      <span>&amp;</span>
      <span>2019-2026</span>
      <a href="https://www.marioforever.net/" target="_blank" rel="noopener noreferrer">Mario Forever 社区</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    padding: 20px var(--layout-content-padding);
    margin-top: auto;
    border-top: 1px solid var(--color-footer-border);
  }

  .footer-inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    text-align: center;
  }

  .footer-text {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 4px;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .footer-text a {
    color: var(--color-link);
    text-decoration: none;
  }

  .footer-text a:hover {
    text-decoration: underline;
  }
</style>
