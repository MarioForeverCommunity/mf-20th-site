---
import type { HistoryItem } from '../types/history';

interface Props {
  item: HistoryItem;
  isLeft: boolean;
  index: number;
  showYear: boolean;
  isLast?: boolean;
}

const { item, isLeft, index, showYear, isLast = false } = Astro.props;
---

<div
  class:list={[
    'timeline-card-wrapper',
    index % 2 !== 0 && 'row-odd',
    isLast && 'is-last',
  ]}
  data-position={isLast ? 'center' : isLeft ? 'left' : 'right'}
  style={`--card-delay: ${index * 0.1}s`}
>
  <!-- Year section header: retro bold header when showYear -->
  {showYear && (
    <div class="timeline-year-header">
      <span class="year-header-text">{item.year}</span>
    </div>
  )}

  <!-- Timeline dot/badge: center line marker -->
  <div class="timeline-dot">
    {isLast ? (
      <span class="dot-ellipsis">……</span>
    ) : showYear ? (
      <span class="dot-year-badge">{item.year}</span>
    ) : (
      <span class="dot-circle"></span>
    )}
  </div>

  <!-- Main row -->
  <div class="timeline-row">
    <!-- Sequential number: retro -->
    <span class="timeline-seq">{index + 1}</span>

    <!-- Thumbnail: retro -->
    {item.image ? (
      <div class="timeline-thumb">
        <img
          src={`/images/history/${item.image}`}
          alt={item.title}
          class="thumb-img"
          loading="lazy"
          onerror="this.style.display='none'"
        />
      </div>
    ) : (
      <div class="timeline-thumb timeline-thumb-placeholder">
        <span class="placeholder-icon">暂无图片</span>
      </div>
    )}

    <!-- Year badge: retro row badge, modern pill -->
    <span class="timeline-year-badge">{isLast ? '……' : item.year}</span>

    <!-- Card body -->
    <div class="timeline-card">
      <h3 class="timeline-title">
        {item.link ? (
          <a href={item.link} target="_blank" rel="noopener noreferrer" class="title-link">{item.title}</a>
        ) : (
          item.title
        )}
      </h3>
      <p class="timeline-desc">
        {item.description}
        {item.link && (
          <a href={item.link} target="_blank" rel="noopener noreferrer" class="desc-link">了解详情&gt;&gt;</a>
        )}
      </p>
      {item.image && (
        <div class="timeline-image">
          <img
            src={`/images/history/${item.image}`}
            alt={item.title}
            class="timeline-img"
            loading="lazy"
          />
        </div>
      )}
    </div>

    <!-- Year right column: retro -->
    <span class="timeline-year-right">{item.year}</span>
  </div>
</div>

<style>
  /* ================================================================
     Base / Reset styles
     ================================================================ */
  .timeline-card-wrapper {
    position: relative;
    width: 100%;
  }

  /* Hide theme-specific elements by modern */
  .timeline-year-header,
  .timeline-dot,
  .timeline-seq,
  .timeline-thumb,
  .timeline-year-badge,
  .timeline-year-right,
  .timeline-image {
    display: none;
  }

  /* Placeholder icon hidden by modern, only shows in retro */
  .placeholder-icon {
    display: none;
  }

  /* Base row layout */
  .timeline-row {
    display: flex;
    align-items: flex-start;
  }

  /* Base card */
  .timeline-card {
    flex: 1;
    min-width: 0;
  }

  .timeline-title {
    margin: 0 0 var(--spacing-xs) 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  .timeline-desc {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .title-link {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .title-link:hover {
    color: var(--color-accent);
  }

  .desc-link {
    color: var(--color-accent);
    white-space: nowrap;
    margin-left: var(--spacing-xs);
  }

  .desc-link:hover {
    text-decoration: underline;
  }

  .timeline-img {
    width: 100%;
    object-fit: contain;
    background-color: var(--color-bg-secondary);
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Dot elements (alternating timeline) */
  .dot-year-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    padding: var(--spacing-xs) var(--spacing-sm);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: #fff;
    box-shadow: var(--shadow-sm);
  }

  .dot-circle {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    box-shadow: var(--shadow-sm);
  }

  .dot-ellipsis {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    padding: var(--spacing-xs) var(--spacing-sm);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: #fff;
  }

  /* ================================================================
     1. retro — Traditional list layout
     ================================================================ */

  /* Year section header */
  :global([data-theme="retro"]) .timeline-year-header {
    display: block;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    padding: var(--spacing-sm) 0 var(--spacing-xs);
    border-bottom: 1px solid var(--color-accent);
    margin-bottom: var(--spacing-xs);
  }

  /* Row: (thumbnail) | content */
  :global([data-theme="retro"]) .timeline-row {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-sm);
  }

  /* Zebra striping */
  :global([data-theme="retro"]) .row-odd .timeline-row {
    background-color: var(--color-row-alt);
  }

  /* Hide year badge in each row (already shown in header) */
  :global([data-theme="retro"]) .timeline-year-badge {
    display: none;
  }

  /* Thumbnail: desktop only */
  :global([data-theme="retro"]) .timeline-thumb {
    display: none;
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-secondary);
  }

  @media (min-width: 768px) {
    :global([data-theme="retro"]) .timeline-thumb {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  :global([data-theme="retro"]) .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: zoom-in;
  }

  /* Placeholder for items without image */
  :global([data-theme="retro"]) .timeline-thumb-placeholder {
    cursor: modern;
  }

  :global([data-theme="retro"]) .placeholder-icon {
    display: inline;
    font-size: 12px;
    opacity: 0.4;
  }

  /* Card: no card styling */
  :global([data-theme="retro"]) .timeline-card {
    background: none;
    border: none;
    box-shadow: none;
    padding: 0;
    border-radius: 0;
    flex: 1;
    min-width: 0;
  }

  /* Title: compact */
  :global([data-theme="retro"]) .timeline-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--spacing-xs);
  }

  /* Description */
  :global([data-theme="retro"]) .timeline-desc {
    font-size: var(--font-size-sm);
  }

  /* Image: mobile only, full width below description */
  :global([data-theme="retro"]) .timeline-image {
    display: block;
    margin-top: var(--spacing-xs);
  }

  @media (min-width: 768px) {
    :global([data-theme="retro"]) .timeline-image {
      display: none;
    }
  }

  :global([data-theme="retro"]) .timeline-img {
    height: auto;
    border-radius: 0;
    cursor: zoom-in;
  }

  /* No animation */
  :global([data-theme="retro"]) .timeline-card-wrapper {
    opacity: 1;
  }

  /* Title link: styled as plain text */
  :global([data-theme="retro"]) .title-link {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  :global([data-theme="retro"]) .title-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* ================================================================
     2. modern — Card flow (mobile) / Alternating timeline (desktop)
     ================================================================ */

  /* --- Mobile: year pill | card flow --- */
  :global([data-theme="modern"]) .timeline-row {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
  }

  /* Year badge as colored pill (mobile only, desktop uses dot) */
  :global([data-theme="modern"]) .timeline-year-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    color: #fff;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    padding: var(--spacing-xs) var(--spacing-sm);
    min-width: 3em;
    margin-top: var(--spacing-sm);
  }

  /* Card: shadow + rounded corners */
  :global([data-theme="modern"]) .timeline-card {
    flex: 1;
    min-width: 0;
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--card-padding);
    transition: box-shadow var(--transition-speed) ease, border-color var(--transition-speed) ease;
  }

  :global([data-theme="modern"]) .timeline-card:hover {
    box-shadow: var(--shadow-lg);
  }

  /* Title */
  :global([data-theme="modern"]) .timeline-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--spacing-sm);
  }

  /* Description */
  :global([data-theme="modern"]) .timeline-desc {
    font-size: var(--font-size-base);
  }

  /* Image within card */
  :global([data-theme="modern"]) .timeline-image {
    display: block;
    margin-top: var(--spacing-md);
  }

  :global([data-theme="modern"]) .timeline-img {
    height: 12rem;
    border-radius: var(--radius-md);
    cursor: zoom-in;
  }

  /* Fade-in-up animation */
  :global([data-theme="modern"]) .timeline-card-wrapper {
    opacity: 0;
    animation: fadeInUp 0.5s ease-out forwards;
    animation-delay: var(--card-delay);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Title link: styled as plain text */
  :global([data-theme="modern"]) .title-link {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  :global([data-theme="modern"]) .title-link:hover {
    color: var(--color-accent);
  }

  /* --- Desktop: alternating timeline with center line --- */
  @media (min-width: 768px) {
    :global([data-theme="modern"]) .timeline-year-badge {
      display: none;
    }

    :global([data-theme="modern"]) .timeline-dot {
      display: block;
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      z-index: 10;
    }

    :global([data-theme="modern"]) .timeline-row {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: calc(50% - 1.25rem);
      gap: 0;
      padding-left: 0;
    }

    :global([data-theme="modern"]) .timeline-card-wrapper[data-position='left'] .timeline-row {
      right: calc(50% + 1.25rem);
      left: auto;
    }

    :global([data-theme="modern"]) .timeline-card-wrapper[data-position='right'] .timeline-row {
      left: calc(50% + 1.25rem);
    }

    :global([data-theme="modern"]) .timeline-card-wrapper[data-position='center'] {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    :global([data-theme="modern"]) .timeline-card-wrapper[data-position='center'] .timeline-row {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      text-align: center;
      width: 100%;
      order: 1;
    }

    :global([data-theme="modern"]) .timeline-card-wrapper[data-position='left'] .timeline-card {
      margin-left: auto;
    }

    :global([data-theme="modern"]) .timeline-card-wrapper[data-position='right'] .timeline-card {
      margin-right: 0;
    }

    :global([data-theme="modern"]) .timeline-card-wrapper[data-position='center'] .timeline-card {
      margin: 0 auto;
    }

    /* 最后一个 dot: 定位在卡片下方, 留出间距 */
    :global([data-theme="modern"]) .timeline-card-wrapper[data-position='center'] .timeline-dot {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      order: 2;
      margin-top: 60px;
      display: flex;
      justify-content: center;
    }

    :global([data-theme="modern"]) .timeline-img {
      height: 10rem;
      border-radius: var(--radius-lg);
    }
  }

  @media (min-width: 1024px) {
    :global([data-theme="modern"]) .timeline-row {
      width: calc(50% - 0.75rem);
    }

    :global([data-theme="modern"]) .timeline-card-wrapper[data-position='left'] .timeline-row {
      right: calc(50% + 0.75rem);
    }

    :global([data-theme="modern"]) .timeline-card-wrapper[data-position='right'] .timeline-row {
      left: calc(50% + 0.75rem);
    }

    :global([data-theme="modern"]) .timeline-card {
      max-width: 26rem;
    }
  }
</style>
