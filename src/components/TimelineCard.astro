---
import type { HistoryItem } from '../types/history';

interface Props {
  item: HistoryItem;
  isLeft: boolean;
  index: number;
  showYear: boolean;
  isLast?: boolean;
}

const { item, isLeft, index, showYear, isLast = false } = Astro.props;
---

<div
  class="timeline-card-wrapper relative h-full w-full"
  data-position={isLast ? 'center' : isLeft ? 'left' : 'right'}
  style={`animation-delay: ${index * 0.1}s`}
>
  {
    isLast ? (
      <div class="timeline-ellipsis-mobile absolute left-1/2 top-1/2 z-10 -translate-x-1/2 -translate-y-1/2 md:hidden">
        <div class="flex items-center justify-center rounded-full bg-[var(--color-accent)] px-3 py-1 ring-4 ring-white/20 backdrop-blur-md">
          <span class="text-xs font-semibold text-white">……</span>
        </div>
      </div>
    ) : (
      <div class="timeline-dot absolute left-1/2 top-1/2 z-10 -translate-x-1/2 -translate-y-1/2">
        {
          showYear ? (
            <div class="flex items-center justify-center rounded-full bg-[var(--color-accent)] px-3 py-1 ring-4 ring-white/20 backdrop-blur-md shadow-[0_2px_8px_rgba(0,113,227,0.3),0_4px_16px_rgba(0,113,227,0.15)]">
              <span class="text-xs font-semibold text-white">{item.year}</span>
            </div>
          ) : (
            <div class="h-4 w-4 rounded-full bg-[var(--color-accent)] ring-4 ring-white/20 backdrop-blur-md shadow-[0_2px_6px_rgba(0,113,227,0.25),0_4px_12px_rgba(0,113,227,0.1)]"></div>
          )
        }
      </div>
    )
  }

  <div
    class:list={[
      'timeline-content relative pl-12 md:pl-0',
      isLeft ? 'md:text-right' : 'md:text-left',
    ]}
  >
    <div
      class:list={[
        'timeline-card card inline-block w-full p-4 text-left md:p-6 lg:max-w-[26rem]',
        isLeft ? 'md:ml-auto' : 'md:mr-auto',
        isLast && 'md:text-center',
      ]}
    >
      <h3 class="mb-2 text-lg font-semibold text-[var(--color-text-primary)]">{item.title}</h3>
      <p class="text-sm text-[var(--color-text-secondary)]">{item.description}</p>
      {
        item.image && (
          <div class="mt-3">
            <img
              src={`/images/history/${item.image}`}
              alt={item.title}
              class="timeline-img h-40 w-full cursor-zoom-in rounded-lg bg-[var(--color-bg-secondary)] object-contain shadow-[0_2px_8px_rgba(0,0,0,0.06),0_4px_16px_rgba(0,0,0,0.04)] transition-transform hover:scale-[1.02] md:h-48"
              loading="lazy"
            />
          </div>
        )
      }
    </div>

    {
      isLast && (
        <div class="timeline-ellipsis mt-8 hidden justify-center md:flex">
          <div class="flex items-center justify-center rounded-full bg-[var(--color-accent)] px-3 py-1">
            <span class="text-xs font-semibold text-white">……</span>
          </div>
        </div>
      )
    }
  </div>
</div>

<div id="image-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-white/90 dark:bg-black/80 p-4 backdrop-blur-md">
  <img id="modal-image" src="" alt="" class="max-h-[90vh] max-w-[90vw] rounded-xl object-contain shadow-[0_8px_32px_rgba(0,0,0,0.12),0_16px_64px_rgba(0,0,0,0.08)] ring-1 ring-black/5 dark:ring-white/10" />
</div>

<style>
  .timeline-card-wrapper {
    opacity: 0;
    animation: slideIn 0.5s ease-out forwards;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 768px) {
    .timeline-content {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: calc(50% - 1.25rem);
    }

    .timeline-card-wrapper[data-position='left'] .timeline-content {
      right: calc(50% + 1.25rem);
      text-align: right;
    }

    .timeline-card-wrapper[data-position='right'] .timeline-content {
      left: calc(50% + 1.25rem);
      text-align: left;
    }

    .timeline-card-wrapper[data-position='center'] .timeline-content {
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      width: auto;
    }

    .timeline-card-wrapper[data-position='center'] .timeline-card {
      margin: 0 auto;
    }
  }

  @media (min-width: 1024px) {
    .timeline-content {
      width: calc(50% - 0.75rem);
    }

    .timeline-card-wrapper[data-position='left'] .timeline-content {
      right: calc(50% + 0.75rem);
    }

    .timeline-card-wrapper[data-position='right'] .timeline-content {
      left: calc(50% + 0.75rem);
    }
  }

  @media (max-width: 768px) {
    .timeline-dot {
      left: 16px;
      transform: translateY(-50%);
    }

    .timeline-ellipsis-mobile {
      left: 16px;
    }
  }

  #image-modal.active {
    display: flex;
  }
</style>

<script>
  const modal = document.getElementById('image-modal');
  const modalImage = document.getElementById('modal-image') as HTMLImageElement;

  document.querySelectorAll('.timeline-img').forEach((img) => {
    img.addEventListener('click', () => {
      if (modal && modalImage) {
        modalImage.src = (img as HTMLImageElement).src;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  function closeModal() {
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal();
    }
  });
</script>
